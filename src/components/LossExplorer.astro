---
---
<div class="lossx card explainer">
  <div>
    <svg class="plot" viewBox="0 0 560 468" role="img" aria-labelledby="lossx-title lossx-desc">
      <title id="lossx-title">Smoothed loss, its derivative and its curvature</title>
      <desc id="lossx-desc">Three stacked plots of the smoothed loss function, its first derivative (the negative dual variable) and its second derivative, with the exact non-smooth loss dashed and the region of positive curvature shaded.</desc>
    </svg>
    <p class="hint">Dashed: the exact loss (δ = 0). Shaded: the terms with positive curvature — the only ones whose dual variables react when a hyperparameter changes.</p>
  </div>
  <div>
    <div class="row">
      <span class="label">Loss</span>
      <div class="chips" data-kind role="group" aria-label="Loss function">
        <button class="chip active" data-v="hinge" aria-pressed="true">Hinge (classification)</button>
        <button class="chip" data-v="eps" aria-pressed="false">ε-insensitive (regression)</button>
      </div>
    </div>
    <div class="row">
      <span class="label">Smoothing degree</span>
      <div class="chips" data-degree role="group" aria-label="Smoothing degree">
        <button class="chip active" data-v="2" aria-pressed="true">2 · C¹, piecewise quadratic</button>
        <button class="chip" data-v="3" aria-pressed="false">3 · C²</button>
        <button class="chip" data-v="6" aria-pressed="false">6 · C²</button>
      </div>
    </div>
    <label class="slider">
      <span>Smoothing width δ <output data-out="delta"></output></span>
      <input type="range" min="0.02" max="1" step="0.01" value="0.5" data-param="delta" />
    </label>
    <label class="slider" data-eps-row hidden>
      <span>Tube width ε <output data-out="eps"></output></span>
      <input type="range" min="0.1" max="0.8" step="0.01" value="0.4" data-param="eps" />
    </label>
    <p class="note" data-explain></p>
  </div>
</div>

<script>
  import { observeWidth, onTheme } from "../lib/plot";

  type F = (t: number) => number;
  // smoothed maximum m_delta(t) of max(0, t) and its derivatives (Strasdat, Sec. 4.4)
  function smoothMax(d: number, degree: string): [F, F, F] {
    const inner = (t: number) => t > -d && t < d;
    if (degree === "2") {
      return [
        (t) => (t >= d ? t : t <= -d ? 0 : ((t + d) ** 2) / (4 * d)),
        (t) => (t >= d ? 1 : t <= -d ? 0 : (t + d) / (2 * d)),
        (t) => (inner(t) ? 1 / (2 * d) : 0),
      ];
    }
    if (degree === "3") {
      return [
        (t) => (t >= d ? t : t <= -d ? 0 : t <= 0 ? (d + t) ** 3 / (6 * d * d) : t + (d - t) ** 3 / (6 * d * d)),
        (t) => (t >= d ? 1 : t <= -d ? 0 : t <= 0 ? (d + t) ** 2 / (2 * d * d) : 1 - (d - t) ** 2 / (2 * d * d)),
        (t) => (inner(t) ? (d - Math.abs(t)) / (d * d) : 0),
      ];
    }
    return [
      (t) => {
        if (t >= d) return t;
        if (t <= -d) return 0;
        const u = t / d;
        return (d * (5 + u * (16 + u * (15 + u * u * (-5 + u * u))))) / 32;
      },
      (t) => {
        if (t >= d) return 1;
        if (t <= -d) return 0;
        const u = t / d;
        return (8 + u * (15 + u * u * (-10 + 3 * u * u))) / 16;
      },
      (t) => {
        if (!inner(t)) return 0;
        const u = t / d;
        return (15 + u * u * (-30 + 15 * u * u)) / (16 * d);
      },
    ];
  }

  const root = document.querySelector<HTMLElement>(".lossx")!;
  const svg = root.querySelector("svg")!;
  const state = { kind: "hinge", degree: "2" };
  const NS = "http://www.w3.org/2000/svg";
  let W = 560;
  const panels = [
    { top: 12, h: 118, label: "loss  φ(t)" },
    { top: 160, h: 118, label: "derivative  φ′(t) = −a   (dual variable)" },
    { top: 308, h: 118, label: "curvature  φ″(t)" },
  ];
  const ML = 44, MR = 14;

  function el<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, text?: string) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  }

  const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-param=${k}]`)!.value);

  function draw() {
    svg.setAttribute("viewBox", `0 0 ${W} 468`);
    const delta = val("delta"), eps = val("eps");
    const hinge = state.kind === "hinge";
    root.querySelector<HTMLElement>("[data-eps-row]")!.hidden = hinge;
    root.querySelector("[data-out=delta]")!.textContent = delta.toFixed(2);
    root.querySelector("[data-out=eps]")!.textContent = eps.toFixed(2);
    const [m, dm, ddm] = smoothMax(delta, state.degree);
    const [m0, dm0] = smoothMax(1e-9, "2");
    // t: margin y f(x) for the hinge loss, residual f(x) - y for the epsilon-insensitive loss
    const [t0, t1] = hinge ? [-1, 3] : [-1.2, 1.2];
    const arg = (t: number) => (hinge ? 1 - t : -t - eps); // argument of the (first) smoothed maximum
    const loss = (mm: F, t: number) => (hinge ? mm(arg(t)) : mm(-t - eps) + mm(t - eps));
    const d1 = (dd: F, t: number) => (hinge ? -dd(arg(t)) : -dd(-t - eps) + dd(t - eps));
    const d2 = (dd: F, t: number) => (hinge ? dd(arg(t)) : dd(-t - eps) + dd(t - eps));
    const series = [
      { f: (t: number) => loss(m, t), g: (t: number) => loss(m0, t) },
      { f: (t: number) => d1(dm, t), g: (t: number) => d1(dm0, t) },
      { f: (t: number) => d2(ddm, t), g: null },
    ];
    const N = 480;
    const xs = Array.from({ length: N + 1 }, (_, i) => t0 + ((t1 - t0) * i) / N);
    const px = (t: number) => ML + ((t - t0) / (t1 - t0)) * (W - ML - MR);
    svg.replaceChildren(svg.querySelector("title")!, svg.querySelector("desc")!);
    // shaded bands where the curvature is positive
    const bands: [number, number][] = hinge ? [[1 - delta, 1 + delta]] : [[-eps - delta, -eps + delta], [eps - delta, eps + delta]];
    panels.forEach((P, pi) => {
      const ys = xs.map((t) => series[pi].f(t));
      const lo = pi === 1 ? (hinge ? -1.15 : -1.2) : 0;
      const top =
        pi === 0 ? Math.max(...xs.map((t) => series[0].g!(t))) * 1.05
        : pi === 1 ? (hinge ? 0.15 : 1.2)
        : Math.max(...ys) * 1.15;
      const py = (y: number) => P.top + P.h - ((y - lo) / (top - lo)) * P.h;
      for (const [a, b] of bands) {
        const x0 = Math.max(px(a), ML), x1 = Math.min(px(b), W - MR);
        if (x1 > x0) svg.append(el("rect", { x: x0, y: P.top, width: x1 - x0, height: P.h, class: "band" }));
      }
      // axes
      svg.append(el("line", { x1: ML, x2: W - MR, y1: py(lo), y2: py(lo), class: "axis" }));
      if (pi === 1) svg.append(el("line", { x1: ML, x2: W - MR, y1: py(0), y2: py(0), class: "axis faint" }));
      svg.append(el("line", { x1: px(0), x2: px(0), y1: P.top, y2: P.top + P.h, class: "axis faint" }));
      svg.append(el("text", { x: ML, y: P.top - 2, class: "lbl" }, P.label));
      const ticks = hinge ? [-1, 0, 1, 2, 3] : [-1, -0.5, 0, 0.5, 1];
      for (const t of ticks) {
        svg.append(el("line", { x1: px(t), x2: px(t), y1: py(lo), y2: py(lo) + 3, class: "axis" }));
        if (pi === 2) svg.append(el("text", { x: px(t), y: py(lo) + 15, class: "tick", "text-anchor": "middle" }, String(t)));
      }
      const yt = pi === 1 ? (hinge ? [-1, 0] : [-1, 0, 1]) : pi === 0 ? [0, 1] : [0, Number((top / 1.15).toPrecision(2))];
      for (const y of yt) svg.append(el("text", { x: ML - 5, y: py(y) + 3, class: "tick", "text-anchor": "end" }, String(y)));
      const g = series[pi].g;
      if (g) {
        const path = xs.map((t, i) => `${i ? "L" : "M"}${px(t).toFixed(1)} ${py(g(t)).toFixed(1)}`).join("");
        svg.append(el("path", { d: path, class: "exact" }));
      }
      const path = xs.map((t, i) => `${i ? "L" : "M"}${px(t).toFixed(1)} ${py(Math.min(series[pi].f(t), top)).toFixed(1)}`).join("");
      svg.append(el("path", { d: path, class: "curve" }));
    });
    svg.append(el("text", { x: W - MR, y: 462, class: "tick", "text-anchor": "end" }, hinge ? "margin  y·f(x)" : "residual  f(x) − y"));
    root.querySelector("[data-explain]")!.textContent = hinge
      ? "Only samples whose margin lies within δ of 1 have positive curvature. Smaller δ gives a sharper corner, a narrower band of reacting terms and a larger curvature 1/(2δ) (degree 2)."
      : "Both sides of the tube are smoothed: the shaded bands sit at the tube edges ±ε. Where the two bands overlap (ε < δ) the sum of the two quadratics depends on ε only through a constant — then ε cannot be tuned.";
  }

  function pick(selector: string, key: "kind" | "degree") {
    root.querySelector(selector)!.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest("[data-v]");
      if (!b) return;
      b.parentElement!.querySelectorAll(".chip").forEach((c) => {
        c.classList.toggle("active", c === b);
        c.setAttribute("aria-pressed", String(c === b));
      });
      state[key] = b.getAttribute("data-v")!;
      draw();
    });
  }
  pick("[data-kind]", "kind");
  pick("[data-degree]", "degree");
  root.querySelectorAll("[data-param]").forEach((e) => e.addEventListener("input", draw));
  onTheme(draw);
  draw();
  observeWidth(svg, (w) => {
    W = Math.max(300, w);
    draw();
  });
</script>

<style is:global>
  .lossx svg .axis {
    stroke: var(--muted);
    stroke-width: 1;
  }
  .lossx svg .axis.faint {
    stroke: var(--line);
  }
  .lossx svg .band {
    fill: var(--accent-soft);
  }
  .lossx svg .curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linejoin: round;
  }
  .lossx svg .exact {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .lossx svg .lbl {
    fill: var(--ink-2);
    font-size: 11.5px;
    font-family: var(--sans);
  }
  .lossx svg .tick {
    fill: var(--muted);
    font-size: 10.5px;
    font-family: var(--mono);
  }
</style>
