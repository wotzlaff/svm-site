---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="hpo-path card explainer" data-src={`${base}/data/hpo-path.json`}>
  <div>
    <canvas class="land" aria-label="Cross-validation error over log λ and log γ with the optimization path" role="img"></canvas>
    <p class="hint">Colour: 5-fold CV error on a 25 × 25 grid; the most saturated basin is the optimum. The line is the path of the gradient method (L-BFGS-B); the triangle marks the best grid point.</p>
    <p class="readout" data-summary aria-live="polite"></p>
  </div>
  <div>
    <canvas class="dec" aria-label="Decision boundary of the model at the current iterate" role="img"></canvas>
    <div class="btn-row">
      <button class="btn small primary" data-play type="button">▶ Replay</button>
      <button class="btn small" data-grid type="button" aria-pressed="false">Show grid points</button>
    </div>
    <label class="slider" style="margin-top: 0.9rem">
      <span>Evaluation <output data-out="step"></output></span>
      <input type="range" min="0" max="0" step="1" value="0" data-param="step" />
    </label>
    <dl class="stats" aria-live="polite">
      <div><dt>log₁₀ λ</dt><dd data-stat="lam">–</dd></div>
      <div><dt>log₁₀ γ</dt><dd data-stat="gamma">–</dd></div>
      <div><dt>CV error</dt><dd data-stat="err">–</dd></div>
      <div><dt>evaluations</dt><dd data-stat="count">–</dd></div>
    </dl>
  </div>
</div>

<script>
  import { contour, css, mix, observeWidth, onTheme, rgb, setupCanvas } from "../lib/plot";
  import { paintLandscape } from "../lib/landscape";

  type Data = {
    grid: number;
    log10_lam: number[];
    log10_gamma: number[];
    cv_error: number[][];
    grid_best: { log10_lam: number; log10_gamma: number; error: number };
    points: [number, number, number][];
    iterates: { log10_lam: number; log10_gamma: number; error: number; decision: number[] }[];
  };

  const root = document.querySelector<HTMLElement>(".hpo-path")!;
  const land = root.querySelector<HTMLCanvasElement>("canvas.land")!;
  const dec = root.querySelector<HTMLCanvasElement>("canvas.dec")!;
  let LW = 560, LH = 520;
  const DS = 380;
  let lctx = setupCanvas(land, LW, LH);
  const dctx = setupCanvas(dec, DS, DS);
  dec.style.aspectRatio = "1";
  const slider = root.querySelector<HTMLInputElement>("[data-param=step]")!;
  const playBtn = root.querySelector<HTMLButtonElement>("[data-play]")!;
  const gridBtn = root.querySelector<HTMLButtonElement>("[data-grid]")!;
  let data: Data;
  let step = 0;
  let showGrid = false;
  let timer = 0;
  const M = { l: 46, r: 12, t: 12, b: 38 };

  const stat = (k: string, v: string) => (root.querySelector(`[data-stat=${k}]`)!.textContent = v);

  function drawLandscape() {
    const xs = data.log10_lam, ys = data.log10_gamma;
    const ink = css("--ink");
    const { px, py } = paintLandscape(lctx, LW, LH, M, xs, ys, data.cv_error);
    // grid points
    if (showGrid) {
      lctx.fillStyle = css("--ink");
      lctx.globalAlpha = 0.55;
      for (const gy of ys) for (const gx of xs) { lctx.beginPath(); lctx.arc(px(gx), py(gy), 1.7, 0, 7); lctx.fill(); }
      lctx.globalAlpha = 1;
    }
    // optimizer path up to the current step
    const warm = css("--accent-2"), it = data.iterates;
    lctx.strokeStyle = css("--surface");
    lctx.lineWidth = 4;
    lctx.beginPath();
    it.slice(0, step + 1).forEach((p, k) => lctx[k ? "lineTo" : "moveTo"](px(p.log10_lam), py(p.log10_gamma)));
    lctx.stroke();
    lctx.strokeStyle = ink;
    lctx.lineWidth = 1.8;
    lctx.beginPath();
    it.slice(0, step + 1).forEach((p, k) => lctx[k ? "lineTo" : "moveTo"](px(p.log10_lam), py(p.log10_gamma)));
    lctx.stroke();
    it.slice(0, step + 1).forEach((p, k) => {
      lctx.fillStyle = k === step ? warm : ink;
      lctx.strokeStyle = css("--surface");
      lctx.lineWidth = 1.5;
      lctx.beginPath();
      lctx.arc(px(p.log10_lam), py(p.log10_gamma), k === step ? 6 : 3.2, 0, 7);
      lctx.fill();
      if (k === step) lctx.stroke();
    });
    // best grid point
    const g = data.grid_best;
    lctx.strokeStyle = css("--surface");
    lctx.fillStyle = ink;
    lctx.lineWidth = 1.5;
    lctx.beginPath();
    lctx.moveTo(px(g.log10_lam), py(g.log10_gamma) - 6);
    lctx.lineTo(px(g.log10_lam) + 6, py(g.log10_gamma) + 5);
    lctx.lineTo(px(g.log10_lam) - 6, py(g.log10_gamma) + 5);
    lctx.closePath();
    lctx.fill();
    lctx.stroke();
  }

  function drawDecision() {
    const p = data.iterates[step], n = data.grid;
    const bg = rgb(css("--surface")), pos = rgb(css("--accent")), neg = rgb(css("--accent-2"));
    const img = dctx.createImageData(n, n);
    for (let j = 0; j < n; j++) {
      for (let i = 0; i < n; i++) {
        const d = p.decision[j * n + i];
        const w = (Math.min(Math.abs(d), 1.5) / 1.5) * 0.32;
        const c = mix(bg, d > 0 ? pos : neg, w);
        const o = 4 * ((n - 1 - j) * n + i);
        img.data[o] = c[0]; img.data[o + 1] = c[1]; img.data[o + 2] = c[2]; img.data[o + 3] = 255;
      }
    }
    const off = new OffscreenCanvas(n, n);
    off.getContext("2d")!.putImageData(img, 0, 0);
    dctx.imageSmoothingEnabled = true;
    dctx.drawImage(off, 0, 0, DS, DS);
    dctx.strokeStyle = css("--ink");
    dctx.lineWidth = 2;
    dctx.beginPath();
    const s = DS / (n - 1);
    for (const [a, b, c, d] of contour((i, j) => p.decision[j * n + i], n, n, 0)) {
      dctx.moveTo(a * s, DS - b * s);
      dctx.lineTo(c * s, DS - d * s);
    }
    dctx.stroke();
    for (const [x, y, c] of data.points) {
      dctx.fillStyle = c > 0 ? css("--accent") : css("--accent-2");
      dctx.beginPath();
      dctx.arc(x * DS, (1 - y) * DS, 3, 0, 7);
      dctx.fill();
    }
  }

  function update() {
    const p = data.iterates[step];
    slider.value = String(step);
    root.querySelector("[data-out=step]")!.textContent = `${step + 1} / ${data.iterates.length}`;
    stat("lam", p.log10_lam.toFixed(2));
    stat("gamma", p.log10_gamma.toFixed(2));
    stat("err", p.error.toFixed(4));
    stat("count", String(step + 1));
    const best = Math.min(...data.iterates.slice(0, step + 1).map((q) => q.error));
    root.querySelector("[data-summary]")!.textContent =
      `Gradient method: best CV error ${best.toFixed(4)} after ${step + 1} evaluation${step ? "s" : ""}. ` +
      `Grid search: best ${data.grid_best.error.toFixed(4)} after ${data.cv_error.length ** 2} evaluations (triangle).`;
    drawLandscape();
    drawDecision();
  }

  function stop() {
    clearInterval(timer);
    timer = 0;
    playBtn.textContent = "▶ Replay";
  }

  playBtn.addEventListener("click", () => {
    if (timer) return stop();
    step = 0;
    update();
    playBtn.textContent = "❚❚ Pause";
    timer = window.setInterval(() => {
      if (step >= data.iterates.length - 1) return stop();
      step++;
      update();
    }, 650);
  });
  slider.addEventListener("input", () => {
    stop();
    step = Number(slider.value);
    update();
  });
  gridBtn.addEventListener("click", () => {
    showGrid = !showGrid;
    gridBtn.setAttribute("aria-pressed", String(showGrid));
    gridBtn.textContent = showGrid ? "Hide grid points" : "Show grid points";
    update();
  });
  onTheme(() => data && update());
  observeWidth(land, (w) => {
    LW = Math.max(300, w);
    LH = Math.round(Math.min(520, Math.max(320, LW * 0.93)));
    land.style.aspectRatio = `${LW} / ${LH}`;
    lctx = setupCanvas(land, LW, LH);
    if (data) drawLandscape();
  });

  fetch(root.dataset.src!)
    .then((r) => r.json())
    .then((d: Data) => {
      data = d;
      step = d.iterates.length - 1;
      slider.max = String(step);
      update();
    });
</script>

<style>
  .readout {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 0.92rem;
    color: var(--ink);
  }
</style>
