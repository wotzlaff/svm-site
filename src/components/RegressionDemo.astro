---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="rdemo card explainer" data-wasm={`${base}/wasm/smo_solver_wasm.wasm`}>
  <div>
    <canvas tabindex="0" role="application" aria-label="Regression data, fitted curve and ε-tube" aria-describedby="rdemo-hint"></canvas>
    <p class="hint" id="rdemo-hint">Click to add a point, shift-click to remove the nearest one. With the keyboard: arrow keys move the cursor, Enter adds a point, Backspace removes the last one.</p>
  </div>
  <div>
    <div class="row">
      <span class="label">Data</span>
      <div class="chips" data-presets role="group" aria-label="Data set">
        <button class="chip active" data-preset="sine" aria-pressed="true">Sine</button>
        <button class="chip" data-preset="line" aria-pressed="false">Noisy line</button>
        <button class="chip" data-preset="outliers" aria-pressed="false">Outliers</button>
        <button class="chip" data-preset="gap" aria-pressed="false">Gap</button>
        <button class="chip" data-preset="clear" aria-pressed="false">Empty</button>
      </div>
    </div>
    <label class="slider">
      <span>Tube width ε <output data-out="eps"></output></span>
      <input type="range" min="0" max="0.25" step="0.005" value="0.08" data-param="eps" />
    </label>
    <label class="slider">
      <span>Regularization λ <output data-out="lam"></output></span>
      <input type="range" min="-5" max="0" step="0.1" value="-3" data-param="lam" />
    </label>
    <label class="slider">
      <span>Kernel width γ <output data-out="gamma"></output></span>
      <input type="range" min="-1" max="3" step="0.05" value="1.5" data-param="gamma" />
    </label>
    <label class="slider">
      <span>Loss smoothing δ <output data-out="smoothing"></output></span>
      <input type="range" min="0" max="0.2" step="0.005" value="0" data-param="smoothing" />
    </label>
    <div class="btn-row">
      <button class="btn small primary" type="button" data-tune>Tune λ and γ</button>
      <button class="btn small" type="button" data-stop hidden>Stop</button>
    </div>
    <p class="tune-status" role="status" data-status></p>
    <div class="tune-panel" data-tune-panel hidden><div class="tune-inset" data-inset></div></div>
    <dl class="stats" aria-live="polite">
      <div><dt>samples</dt><dd data-stat="n">–</dd></div>
      <div><dt>support vectors</dt><dd data-stat="sv">–</dd></div>
      <div><dt>SMO steps</dt><dd data-stat="steps">–</dd></div>
      <div><dt>training time</dt><dd data-stat="time">–</dd></div>
      <div><dt>points inside the tube</dt><dd data-stat="inside">–</dd></div>
      <div><dt>mean absolute error</dt><dd data-stat="mae">–</dd></div>
      <div><dt>5-fold CV loss</dt><dd data-stat="cv">–</dd></div>
      <div><dt>CV evaluations</dt><dd data-stat="evals">–</dd></div>
    </dl>
    <p class="note">
      ε-insensitive regression with the Rust solver in WebAssembly. Points inside the tube cost nothing,
      so only the ringed points (on or outside its boundary) are support vectors; the segments show
      how far the others stick out. Increase ε and the model gets sparser.
    </p>
    <p class="note">
      <strong>Tune λ and γ</strong> minimizes the 5-fold cross-validation loss (smoothed absolute error on the held-out folds) with
      L-BFGS-B and exact gradients, keeping ε at the slider value. The gradient needs a smoothed loss, so a
      smoothing δ of 0 is raised to 0.05 for tuning.
    </p>
  </div>
</div>

<script>
  import { css, fmt, onTheme, setupCanvas } from "../lib/plot";
  import { getSvmClient, SvmCancelledError, SvmSupersededError, type SvmTrainResult, type SvmTuneProgress } from "../lib/svm-client";
  import { createPacer, createTuneInset, type TunePoint } from "../lib/tune-ui";

  const root = document.querySelector<HTMLElement>(".rdemo")!;
  const canvas = root.querySelector("canvas")!;
  const W = 560, H = 420, M = { l: 8, r: 8, t: 10, b: 10 };
  const ctx = setupCanvas(canvas, W, H);
  canvas.style.aspectRatio = `${W} / ${H}`;
  const NX = 240; // curve resolution
  const solver = getSvmClient(root.dataset.wasm!);
  let points: { x: number; y: number }[] = [];
  let pending = 0;
  let keyboardActive = false;
  const LN10 = Math.LN10;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const sliders = (k: string) => q<HTMLInputElement>(`[data-param=${k}]`);
  /** Exact parameters set by the tuner; cleared as soon as a slider is moved by hand. */
  let exact: { lam: number; gamma: number; smoothing: number } | null = null;
  let busy: "idle" | "tuning" = "idle";
  const cursor = { x: 0.5, y: 0.5 };
  let last: { f: Float64Array | null; sv: Set<number>; eps: number } = { f: null, sv: new Set(), eps: 0 };

  function rng(seed: number) {
    return () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
  }

  function preset(name: string) {
    const r = rng(11);
    const gauss = () => Math.sqrt(-2 * Math.log(r() + 1e-12)) * Math.cos(2 * Math.PI * r());
    const pts: typeof points = [];
    const sine = (x: number) => 0.5 + 0.32 * Math.sin(2 * Math.PI * x);
    if (name === "sine") {
      for (let i = 0; i < 70; i++) {
        const x = r();
        pts.push({ x, y: sine(x) + 0.045 * gauss() });
      }
    } else if (name === "line") {
      for (let i = 0; i < 60; i++) {
        const x = r();
        pts.push({ x, y: 0.2 + 0.6 * x + 0.06 * gauss() });
      }
    } else if (name === "outliers") {
      for (let i = 0; i < 70; i++) {
        const x = r();
        const out = r() < 0.1;
        pts.push({ x, y: Math.min(0.97, Math.max(0.03, sine(x) + 0.03 * gauss() + (out ? (r() < 0.5 ? -1 : 1) * 0.3 : 0))) });
      }
    } else if (name === "gap") {
      for (let i = 0; i < 60; i++) {
        let x = r();
        if (x > 0.4 && x < 0.62) x += 0.25;
        pts.push({ x: Math.min(x, 1), y: sine(Math.min(x, 1)) + 0.04 * gauss() });
      }
    }
    points = pts;
  }

  function params() {
    const v = (k: string) => Number(sliders(k).value);
    return { eps: v("eps"), lam: exact?.lam ?? 10 ** v("lam"), gamma: exact?.gamma ?? 10 ** v("gamma"),
             smoothing: exact?.smoothing ?? v("smoothing") };
  }

  const px = (x: number) => M.l + x * (W - M.l - M.r);
  const py = (y: number) => H - M.b - y * (H - M.t - M.b);

  function render(f: Float64Array | null, sv: Set<number>, eps: number) {
    last = { f, sv, eps };
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = css("--surface");
    ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = css("--line");
    ctx.lineWidth = 1;
    for (let k = 0; k <= 4; k++) {
      ctx.beginPath();
      ctx.moveTo(M.l, py(k / 4));
      ctx.lineTo(W - M.r, py(k / 4));
      ctx.stroke();
    }
    const accent = css("--accent"), ink = css("--ink"), warm = css("--accent-2");
    if (f) {
      // tube
      ctx.fillStyle = css("--accent-soft");
      ctx.beginPath();
      for (let i = 0; i < NX; i++) ctx[i ? "lineTo" : "moveTo"](px(i / (NX - 1)), py(f[i] + eps));
      for (let i = NX - 1; i >= 0; i--) ctx.lineTo(px(i / (NX - 1)), py(f[i] - eps));
      ctx.closePath();
      ctx.fill();
      ctx.strokeStyle = accent;
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1;
      for (const s of [-1, 1]) {
        ctx.beginPath();
        for (let i = 0; i < NX; i++) ctx[i ? "lineTo" : "moveTo"](px(i / (NX - 1)), py(f[i] + s * eps));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      // residual segments of points outside the tube
      const at = (x: number) => {
        const t = Math.min(Math.max(x, 0), 1) * (NX - 1), i = Math.min(Math.floor(t), NX - 2), a = t - i;
        return f[i] * (1 - a) + f[i + 1] * a;
      };
      ctx.strokeStyle = warm;
      ctx.lineWidth = 1.4;
      for (const p of points) {
        const fx = at(p.x), d = p.y - fx;
        if (Math.abs(d) > eps) {
          ctx.beginPath();
          ctx.moveTo(px(p.x), py(p.y));
          ctx.lineTo(px(p.x), py(fx + Math.sign(d) * eps));
          ctx.stroke();
        }
      }
      ctx.strokeStyle = accent;
      ctx.lineWidth = 2.6;
      ctx.beginPath();
      for (let i = 0; i < NX; i++) ctx[i ? "lineTo" : "moveTo"](px(i / (NX - 1)), py(f[i]));
      ctx.stroke();
    }
    points.forEach((p, k) => {
      ctx.fillStyle = ink;
      ctx.globalAlpha = 0.8;
      ctx.beginPath();
      ctx.arc(px(p.x), py(p.y), 3.4, 0, 2 * Math.PI);
      ctx.fill();
      ctx.globalAlpha = 1;
      if (sv.has(k)) {
        ctx.strokeStyle = warm;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(px(p.x), py(p.y), 7, 0, 2 * Math.PI);
        ctx.stroke();
      }
    });
    if (document.activeElement === canvas && keyboardActive) {
      const x = px(cursor.x), y = py(cursor.y);
      ctx.strokeStyle = ink;
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.arc(x, y, 11, 0, 2 * Math.PI);
      ctx.moveTo(x - 16, y);
      ctx.lineTo(x + 16, y);
      ctx.moveTo(x, y - 16);
      ctx.lineTo(x, y + 16);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  const setStat = (k: string, v: string) => (root.querySelector(`[data-stat=${k}]`)!.textContent = v);

  async function train() {
    const n = points.length;
    setStat("n", String(n));
    const { eps, lam, gamma, smoothing } = params();
    if (n < 2) {
      for (const k of ["sv", "steps", "time", "inside", "mae"]) setStat(k, "–");
      render(null, new Set(), eps);
      return;
    }
    const snapshot = points.slice();
    if (last.f) render(last.f, last.sv, last.eps); // show the new points right away, the model follows
    let r;
    try {
      r = await solver.train({
        x: new Float64Array(snapshot.map((p) => p.x)),
        y: new Float64Array(snapshot.map((p) => p.y)),
        dim: 1, kind: "regression", lambda: lam, gamma, smoothing, epsilon: eps, tol: 1e-4,
        grid: Float64Array.from({ length: NX }, (_, i) => i / (NX - 1)),
      });
    } catch (err) {
      if (!(err instanceof SvmSupersededError || err instanceof SvmCancelledError)) console.error(err);
      return;
    }
    showResult(snapshot, r, eps);
  }

  function showResult(snapshot: typeof points, r: SvmTrainResult, eps: number) {
    const n = snapshot.length;
    if (r.steps < 0) {
      render(null, new Set(), eps);
      return;
    }
    let inside = 0, mae = 0;
    snapshot.forEach((p, k) => {
      const d = Math.abs(p.y - r.decisionOnTrain[k]);
      mae += d / n;
      if (d <= eps + 1e-9) inside++;
    });
    // for regression the solver numbers the two copies of each sample: map back to samples
    const sv = new Set(Array.from(r.support, (v) => Number(v) % n));
    setStat("sv", `${sv.size} (${Math.round((100 * sv.size) / n)} %)`);
    setStat("steps", r.steps.toLocaleString("en"));
    setStat("time", `${(1000 * r.seconds).toFixed(1)} ms`);
    setStat("inside", `${inside} (${Math.round((100 * inside) / n)} %)`);
    setStat("mae", mae.toFixed(3));
    render(r.decisionOnGrid, sv, eps);
  }

  function schedule() {
    const { eps, lam, gamma, smoothing } = params();
    const out = (k: string, s: string) => (root.querySelector(`[data-out=${k}]`)!.textContent = s);
    out("eps", eps.toFixed(3));
    out("lam", fmt(lam));
    out("gamma", fmt(gamma));
    out("smoothing", smoothing.toFixed(3));
    if (busy !== "idle") return; // the tuner owns the picture
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(train);
  }

  function activate(group: Element, button: Element) {
    group.querySelectorAll(".chip").forEach((b) => {
      b.classList.toggle("active", b === button);
      b.setAttribute("aria-pressed", String(b === button));
    });
  }

  function toData(ev: MouseEvent) {
    const r = canvas.getBoundingClientRect();
    const sx = W / r.width, sy = H / r.height;
    return {
      x: Math.min(1, Math.max(0, ((ev.clientX - r.left) * sx - M.l) / (W - M.l - M.r))),
      y: Math.min(1, Math.max(0, 1 - ((ev.clientY - r.top) * sy - M.t) / (H - M.t - M.b))),
    };
  }

  root.querySelectorAll("[data-param]").forEach((el) =>
    el.addEventListener("input", () => {
      if (el !== sliders("eps")) exact = null; // ε keeps the tuned λ, γ, δ
      edited();
    }),
  );
  root.querySelector("[data-presets]")!.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("[data-preset]");
    if (!b) return;
    activate(b.parentElement!, b);
    preset(b.getAttribute("data-preset")!);
    edited();
  });
  canvas.addEventListener("click", (ev) => {
    if (busy !== "idle") return;
    keyboardActive = false;
    const p = toData(ev);
    if (ev.shiftKey && points.length) {
      let best = 0, bd = Infinity;
      points.forEach((q, k) => {
        const d = (q.x - p.x) ** 2 + ((q.y - p.y) * 0.75) ** 2;
        if (d < bd) [best, bd] = [k, d];
      });
      points.splice(best, 1);
    } else {
      points.push(p);
    }
    edited();
  });
  canvas.addEventListener("keydown", (ev) => {
    if (busy !== "idle") return;
    const step = ev.shiftKey && ev.key !== "Enter" ? 0.1 : 0.02;
    const move: Record<string, [number, number]> = {
      ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, step], ArrowDown: [0, -step],
    };
    if (ev.key in move) {
      cursor.x = Math.min(1, Math.max(0, cursor.x + move[ev.key][0]));
      cursor.y = Math.min(1, Math.max(0, cursor.y + move[ev.key][1]));
    } else if (ev.key === "Enter" || ev.key === " ") {
      points.push({ x: cursor.x, y: cursor.y });
      edited();
    } else if (ev.key === "Backspace" || ev.key === "Delete") {
      points.pop();
      edited();
    } else {
      return;
    }
    ev.preventDefault();
    keyboardActive = true;
    render(last.f, last.sv, last.eps);
  });
  canvas.addEventListener("focus", () => {
    keyboardActive = true;
    render(last.f, last.sv, last.eps);
  });
  canvas.addEventListener("blur", () => render(last.f, last.sv, last.eps));
  onTheme(() => render(last.f, last.sv, last.eps));

  // ---- hyperparameter tuning ----
  const statusEl = q("[data-status]");
  const tuneBtn = q<HTMLButtonElement>("[data-tune]");
  const stopBtn = q<HTMLButtonElement>("[data-stop]");
  const tunePanel = q("[data-tune-panel]");
  const range = (k: string): [number, number] => [Number(sliders(k).min), Number(sliders(k).max)];
  const inset = createTuneInset(q("[data-inset]"), { lam: range("lam"), gamma: range("gamma") });
  const status = (t: string) => (statusEl.textContent = t);
  let stopped = false;

  /** Data or parameters were changed by the user: the CV numbers no longer apply. */
  function edited() {
    setStat("cv", "–");
    setStat("evals", "–");
    status("");
    schedule();
  }

  function setLocked(on: boolean) {
    root.querySelectorAll<HTMLInputElement | HTMLButtonElement>("[data-param], [data-preset]").forEach((el) => (el.disabled = on));
    tuneBtn.disabled = on;
    stopBtn.hidden = !on;
    canvas.setAttribute("aria-disabled", String(on));
  }

  function showParams(lam: number, gamma: number, smoothing: number) {
    exact = { lam, gamma, smoothing };
    sliders("lam").value = String(Math.log10(lam));
    sliders("gamma").value = String(Math.log10(gamma));
    sliders("smoothing").value = String(smoothing);
    q("[data-out=lam]").textContent = fmt(lam);
    q("[data-out=gamma]").textContent = fmt(gamma);
    q("[data-out=smoothing]").textContent = smoothing.toFixed(3);
  }

  async function tune() {
    if (busy !== "idle") return;
    const snap = points.slice();
    if (snap.length < 10) return status("Tuning needs at least 10 points (5-fold cross-validation).");
    if (solver.mode === "main") return status("Tuning needs Web Workers, which this browser does not provide.");
    let { eps, lam, gamma, smoothing } = params();
    let note = "";
    if (smoothing <= 0) {
      smoothing = 0.05;
      note = " Smoothing δ was 0 and is now 0.05: the hypergradient needs a smoothed loss.";
    }
    showParams(lam, gamma, smoothing);
    busy = "tuning";
    stopped = false;
    setLocked(true);
    stopBtn.focus();
    tunePanel.hidden = false;
    const hist: TunePoint[] = [];
    inset.set(hist);
    setStat("cv", "–");
    setStat("evals", "0");
    status("Tuning…" + note);
    const toSv = (support: Float64Array) => new Set(Array.from(support, (v) => Number(v) % snap.length));
    const pacer = createPacer<SvmTuneProgress>((pr) => {
      showParams(Math.exp(pr.logLambda), Math.exp(pr.logGamma), smoothing);
      hist.push({ ll: pr.logLambda / LN10, lg: pr.logGamma / LN10, value: pr.value });
      inset.set(hist);
      setStat("cv", pr.value.toFixed(4));
      setStat("evals", String(pr.evaluation));
      render(pr.decisionOnGrid, toSv(pr.support), eps);
    });
    try {
      const res = await solver.tune(
        {
          x: new Float64Array(snap.map((p) => p.x)),
          y: new Float64Array(snap.map((p) => p.y)),
          dim: 1, kind: "regression", folds: 5, smoothing, epsilon: eps, tol: 1e-6, trainTol: 1e-4,
          initial: [Math.log(lam), Math.log(gamma)],
          lower: [range("lam")[0] * LN10, range("gamma")[0] * LN10],
          upper: [range("lam")[1] * LN10, range("gamma")[1] * LN10],
          maxIterations: 40, gradientTolerance: 1e-3, maxEvaluations: 60,
          grid: Float64Array.from({ length: NX }, (_, i) => i / (NX - 1)),
        },
        (pr) => pacer.push(pr),
      );
      await pacer.drain();
      if (stopped) throw new SvmCancelledError();
      showParams(Math.exp(res.logLambda), Math.exp(res.logGamma), smoothing);
      showResult(snap, res.final, eps);
      setStat("cv", res.value.toFixed(4));
      setStat("evals", String(res.evaluations));
      const why = res.status === "converged" ? "converged"
        : res.status === "evaluation-limit" ? "stopped at the evaluation limit"
        : res.status === "solver-failure" ? "stopped: the solver did not converge at a trial point (best point kept)"
        : "finished without further progress";
      status(
        `Tuning ${why} after ${res.evaluations} evaluations${Number.isFinite(res.iterations) ? ` (${res.iterations} iterations)` : ""} ` +
          `in ${res.seconds.toFixed(1)} s: λ = ${fmt(Math.exp(res.logLambda))}, γ = ${fmt(Math.exp(res.logGamma))}, ` +
          `5-fold CV loss ${res.value.toFixed(4)}.` + note,
      );
    } catch (err) {
      pacer.clear();
      if (err instanceof SvmCancelledError) {
        status(`Stopped after ${q("[data-stat=evals]").textContent} evaluations; the model shows the last parameters tried.`);
      } else {
        console.error(err);
        status(`Tuning failed: ${err instanceof Error ? err.message : err}`);
      }
      busy = "idle";
      schedule();
    } finally {
      const focusWasStop = document.activeElement === stopBtn;
      busy = "idle";
      setLocked(false);
      if (focusWasStop) tuneBtn.focus();
    }
  }
  stopBtn.addEventListener("click", () => {
    stopped = true;
    solver.cancel();
  });
  tuneBtn.addEventListener("click", tune);

  preset("sine");
  schedule();
</script>

<style>
  canvas {
    cursor: crosshair;
    touch-action: manipulation;
  }
  canvas:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
</style>
