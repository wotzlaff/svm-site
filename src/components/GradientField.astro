---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="gfield card explainer" data-src={`${base}/data/hpo-path.json`} data-optimizer={`${base}/wasm/svm_browser_optimizer_bg.wasm`}>
  <div>
    <canvas tabindex="0" role="application" aria-label="CV error landscape with gradient arrows; click to start gradient descent and L-BFGS from that point" aria-describedby="gfield-hint"></canvas>
    <p class="hint" id="gfield-hint">Click anywhere to start the selected optimizer from that point. With the keyboard: arrow keys move the cursor, Enter starts it.</p>
  </div>
  <div>
    <div class="row">
      <span class="label">Method</span>
      <div class="chips" data-methods role="group" aria-label="Optimization method">
        <button class="chip" data-method="gd" type="button" aria-pressed="false">Gradient descent</button>
        <button class="chip" data-method="lbfgs" type="button" aria-pressed="false">L-BFGS</button>
        <button class="chip active" data-method="both" type="button" aria-pressed="true">Both</button>
      </div>
    </div>
    <div class="row">
      <span class="label">Start from</span>
      <div class="chips" data-starts role="group" aria-label="Preset starting points">
        <button class="chip" data-start="-4,0.4" type="button">small λ, small γ</button>
        <button class="chip" data-start="-0.4,2.8" type="button">large λ, large γ</button>
        <button class="chip" data-start="-3.6,2.6" type="button">on a plateau</button>
      </div>
    </div>
    <div class="btn-row" style="margin-top: 0">
      <button class="btn small" data-arrows type="button" aria-pressed="true">Hide arrows</button>
      <button class="btn small" data-clear type="button">Clear path</button>
    </div>
    <dl class="stats" aria-live="polite">
      <div><dt>log₁₀ λ</dt><dd data-stat="x">–</dd></div>
      <div><dt>log₁₀ γ</dt><dd data-stat="y">–</dd></div>
      <div><dt>CV error</dt><dd data-stat="e">–</dd></div>
      <div><dt>‖gradient‖</dt><dd data-stat="g">–</dd></div>
      <div><dt>∂E / ∂log₁₀ λ</dt><dd data-stat="gx">–</dd></div>
      <div><dt>∂E / ∂log₁₀ γ</dt><dd data-stat="gy">–</dd></div>
    </dl>
    <p class="legend" data-legend aria-hidden="true">
      <span data-leg="gd"><i class="sw gd"></i>{" "}Gradient descent</span>{" "}
      <span data-leg="lbfgs"><i class="sw lb"></i>{" "}L-BFGS</span>
    </p>
    <p class="readout" data-summary aria-live="polite">Hover over the map to read the exact gradient at a point.</p>
    <p class="note">
      Arrows show the negative gradient (steepest descent), longer where it is steeper. Error and gradient were
      computed with <code>optimized-svm</code> at the 625 grid nodes — every gradient is exact, from one adjoint
      system per fold. Both methods run on the same interpolated surface, a bicubic Hermite interpolant built
      from the exact node gradients, so its value and gradient are consistent, which the L-BFGS line search
      needs. The runs are replays on this precomputed surface. Plain gradient descent zig-zags in the narrow
      valley; L-BFGS is what the library uses.
    </p>
  </div>
</div>

<script>
  import { css, fmt, observeWidth, onTheme, setupCanvas } from "../lib/plot";
  import { paintLandscape } from "../lib/landscape";
  import { createHermite } from "../lib/hermite";

  type Data = {
    log10_lam: number[];
    log10_gamma: number[];
    cv_error: number[][];
    grad_log10_lam: number[][];
    grad_log10_gamma: number[][];
  };
  const root = document.querySelector<HTMLElement>(".gfield")!;
  const canvas = root.querySelector("canvas")!;
  let W = 560, H = 500;
  let ctx = setupCanvas(canvas, W, H);
  const M = { l: 46, r: 12, t: 12, b: 38 };
  let data: Data;
  let showArrows = true;
  type Method = "gd" | "lbfgs" | "both";
  type Run = { pts: [number, number][]; label: string; evals?: number };
  let method: Method = "both";
  let runs: { gd?: Run; lbfgs?: Run } = {};
  let shown = 0; // number of path segments drawn so far
  let token = 0; // invalidates a start() that is still waiting for the optimizer to load
  let timer = 0;
  let hover: [number, number] | null = null;
  const cursor: [number, number] = [-2, 1.5];
  let keyboardActive = false;

  const stat = (k: string, v: string) => (root.querySelector(`[data-stat=${k}]`)!.textContent = v);
  const summary = root.querySelector<HTMLElement>("[data-summary]")!;

  // bicubic Hermite interpolant of the grid: E and G are value and exact gradient of the same surface
  let E: (x: number, y: number) => number;
  let G: (x: number, y: number) => [number, number];

  function readout(p: [number, number]) {
    const [gx, gy] = G(...p);
    stat("x", p[0].toFixed(2));
    stat("y", p[1].toFixed(2));
    stat("e", E(...p).toFixed(4));
    stat("g", fmt(Math.hypot(gx, gy)));
    stat("gx", fmt(gx));
    stat("gy", fmt(gy));
  }

  function draw() {
    const { px, py, x0, x1, y0, y1, dark, vmin, vmax } = paintLandscape(ctx, W, H, M, data.log10_lam, data.log10_gamma, data.cv_error);
    const ink = css("--ink"), warm = css("--accent-2");
    const kx = (W - M.l - M.r) / (x1 - x0), ky = (H - M.t - M.b) / (y1 - y0);
    if (showArrows) {
      const xs = data.log10_lam, ys = data.log10_gamma;
      const step = W < 420 ? 3 : 2;
      const vecs: { x: number; y: number; dx: number; dy: number; m: number }[] = [];
      for (let j = 1; j < ys.length; j += step) {
        for (let i = 1; i < xs.length; i += step) {
          const gx = data.grad_log10_lam[j][i], gy = data.grad_log10_gamma[j][i];
          // steepest descent as it appears on the screen (perpendicular to the contour lines)
          const dx = -gx / kx, dy = gy / ky; // screen y points down
          vecs.push({ x: px(xs[i]), y: py(ys[j]), dx, dy, m: Math.hypot(dx, dy) });
        }
      }
      const mmax = Math.max(...vecs.map((v) => v.m));
      const cell = ((W - M.l - M.r) / xs.length) * step;
      // light arrows on the dark part of the map, dark ones on the light part
      const light = "#f8fafc", deepInk = dark ? css("--surface") : ink;
      ctx.lineWidth = 1.6;
      for (const v of vecs) {
        if (v.m === 0) continue;
        const tt = (Math.log10(E(x0 + ((v.x - M.l) / (W - M.l - M.r)) * (x1 - x0), y0 + ((H - M.b - v.y) / (H - M.t - M.b)) * (y1 - y0))) - vmin) / (vmax - vmin);
        const onDark = dark ? tt >= 0.5 : tt < 0.5;
        ctx.strokeStyle = ctx.fillStyle = onDark ? light : deepInk;
        const t = Math.sqrt(v.m / mmax);
        const len = 5 + t * (cell * 0.85 - 5);
        const ux = v.dx / v.m, uy = v.dy / v.m;
        const x1a = v.x - (ux * len) / 2, y1a = v.y - (uy * len) / 2, x2 = v.x + (ux * len) / 2, y2 = v.y + (uy * len) / 2;
        ctx.globalAlpha = 0.35 + 0.55 * t;
        ctx.beginPath();
        ctx.moveTo(x1a, y1a);
        ctx.lineTo(x2, y2);
        ctx.stroke();
        const h = 3.4;
        ctx.beginPath();
        ctx.moveTo(x2, y2);
        ctx.lineTo(x2 - ux * h - uy * h * 0.6, y2 - uy * h + ux * h * 0.6);
        ctx.lineTo(x2 - ux * h + uy * h * 0.6, y2 - uy * h - ux * h * 0.6);
        ctx.closePath();
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    }
    // optimizer paths: gradient descent (circles, warm accent) and L-BFGS (squares, green)
    const drawPath = (run: Run | undefined, col: string, square: boolean) => {
      if (!run) return;
      const pts = run.pts.slice(0, Math.min(shown, run.pts.length - 1) + 1);
      const trace = () => pts.forEach((p, k) => ctx[k ? "lineTo" : "moveTo"](px(p[0]), py(p[1])));
      ctx.lineJoin = "round";
      ctx.strokeStyle = css("--surface");
      ctx.lineWidth = 4.5;
      ctx.beginPath();
      trace();
      ctx.stroke();
      ctx.strokeStyle = col;
      ctx.lineWidth = 2.2;
      ctx.beginPath();
      trace();
      ctx.stroke();
      pts.forEach((p, k) => {
        const last = k === pts.length - 1, r = last ? 6 : 3;
        ctx.fillStyle = last ? col : css("--surface");
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        if (square) ctx.rect(px(p[0]) - r, py(p[1]) - r, 2 * r, 2 * r);
        else ctx.arc(px(p[0]), py(p[1]), r, 0, 7);
        ctx.fill();
        ctx.stroke();
      });
    };
    drawPath(runs.gd, warm, false);
    drawPath(runs.lbfgs, css("--ok"), true);
    const mark = hover ?? (keyboardActive ? cursor : null);
    if (mark && !timer) {
      ctx.strokeStyle = ink;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.arc(px(mark[0]), py(mark[1]), 9, 0, 7);
      ctx.moveTo(px(mark[0]) - 14, py(mark[1]));
      ctx.lineTo(px(mark[0]) + 14, py(mark[1]));
      ctx.moveTo(px(mark[0]), py(mark[1]) - 14);
      ctx.lineTo(px(mark[0]), py(mark[1]) + 14);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  // normalised gradient steps with a cap (step length min(cap, eta |g|) decades) on the exact gradient
  // field; stops when the interpolated error has not improved for a while
  function descend(start: [number, number]) {
    const xs = data.log10_lam, ys = data.log10_gamma;
    const clamp = (p: number[]): [number, number] => [
      Math.min(Math.max(p[0], xs[0]), xs[xs.length - 1]),
      Math.min(Math.max(p[1], ys[0]), ys[ys.length - 1]),
    ];
    const pts: [number, number][] = [clamp(start)];
    const es = [E(...pts[0])];
    const ETA = 6, CAP = 0.15, WINDOW = 8;
    for (let it = 0; it < 90; it++) {
      const p = pts[pts.length - 1];
      const [gx, gy] = G(...p);
      const gn = Math.hypot(gx, gy);
      if (gn < 3e-3) break;
      const len = Math.min(CAP, ETA * gn);
      const q = clamp([p[0] - (len * gx) / gn, p[1] - (len * gy) / gn]);
      pts.push(q);
      es.push(E(...q));
      if (es.length > WINDOW + 1 && Math.min(...es.slice(-WINDOW)) > Math.min(...es.slice(0, -WINDOW)) - 3e-4) break;
    }
    return pts;
  }

  // L-BFGS (WebAssembly optimizer of the library) on the interpolated surface. The optimizer API only returns
  // the final point, so the accepted iterates are obtained by re-running it from the same start with
  // maxIterations = 1, 2, ...: it is deterministic, so run k ends at iterate k exactly. The cost is trivial.
  type Optimizer = Awaited<ReturnType<typeof import("../lib/vendor/browser-optimizer/optimizer.mjs").createOptimizer>>;
  let optimizer: Promise<Optimizer> | undefined;
  function loadOptimizer() {
    optimizer ??= import("../lib/vendor/browser-optimizer/optimizer.mjs")
      .then((m) => m.createOptimizer(new URL(root.dataset.optimizer!, location.href).href))
      .catch((e) => {
        optimizer = undefined;
        throw e;
      });
    return optimizer;
  }
  function lbfgs(opt: Optimizer, start: [number, number]): Run {
    const xs = data.log10_lam, ys = data.log10_gamma;
    const lower = [xs[0], ys[0]], upper = [xs[xs.length - 1], ys[ys.length - 1]];
    const pts: [number, number][] = [start];
    let evals = 0;
    for (let k = 1; k <= 100; k++) {
      const res = opt.minimize({
        initial: start,
        lower,
        upper,
        maxIterations: k,
        gradientTolerance: 3e-3,
        evaluate: (x) => {
          const [gx, gy] = G(x[0], x[1]);
          return { value: E(x[0], x[1]), gradient: [gx, gy] };
        },
      });
      evals = res.evaluations;
      if (res.iterations < k) break; // already converged earlier
      pts.push([res.x[0], res.x[1]]);
      if (res.status !== "iteration-limit") break;
    }
    return { pts, label: "L-BFGS", evals };
  }

  async function start(p: [number, number]) {
    clearInterval(timer);
    timer = 0;
    const my = ++token;
    summary.textContent = "";
    const xs = data.log10_lam, ys = data.log10_gamma;
    const s0: [number, number] = [Math.min(Math.max(p[0], xs[0]), xs[xs.length - 1]), Math.min(Math.max(p[1], ys[0]), ys[ys.length - 1])];
    runs = {};
    let failed = "";
    if (method !== "lbfgs") runs.gd = { pts: descend(s0), label: "Gradient descent" };
    if (method !== "gd") {
      try {
        const opt = await loadOptimizer();
        if (my !== token) return;
        runs.lbfgs = lbfgs(opt, s0);
      } catch {
        if (my !== token) return;
        failed = "The L-BFGS optimizer could not be loaded.";
        runs.gd ??= { pts: descend(s0), label: "Gradient descent" };
      }
    }
    const len = Math.max(...Object.values(runs).map((r) => r.pts.length)) - 1;
    shown = 0;
    summary.textContent = "";
    const lead = (runs.gd ?? runs.lbfgs)!;
    readout(lead.pts[0]);
    const done = () => {
      timer = 0;
      finish(failed);
      draw();
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      shown = len;
      done();
      return;
    }
    timer = window.setInterval(() => {
      shown++;
      readout(lead.pts[Math.min(shown, lead.pts.length - 1)]);
      draw();
      if (shown >= len) {
        clearInterval(timer);
        done();
      }
    }, 90);
    draw();
  }

  function finish(failed: string) {
    const best = Math.min(...data.cv_error.flat());
    const parts: string[] = [];
    let stalled = false;
    for (const r of [runs.gd, runs.lbfgs]) {
      if (!r) continue;
      const last = r.pts[r.pts.length - 1], e = E(...last);
      const stall = e - best > 0.05;
      stalled ||= stall;
      const n = r.pts.length - 1;
      const cost = r.evals === undefined ? `${n} steps` : `${n} iterations (${r.evals} evaluations)`;
      parts.push(`${r.label}: ${cost} → CV error ${e.toFixed(4)}${stall ? " (stalled on a plateau)" : ""}.`);
    }
    const lead = (runs.gd ?? runs.lbfgs)!;
    readout(lead.pts[lead.pts.length - 1]);
    summary.textContent =
      parts.join(" ") +
      (stalled ? " The gradient almost vanishes on a plateau; gradient methods need a sensible start (or restarts)." : "") +
      (failed ? ` ${failed}` : "");
  }

  function toData(ev: MouseEvent): [number, number] {
    const r = canvas.getBoundingClientRect();
    const sx = W / r.width, sy = H / r.height;
    const xs = data.log10_lam, ys = data.log10_gamma;
    const fx = (((ev.clientX - r.left) * sx - M.l) / (W - M.l - M.r));
    const fy = 1 - (((ev.clientY - r.top) * sy - M.t) / (H - M.t - M.b));
    return [
      xs[0] + Math.min(1, Math.max(0, fx)) * (xs[xs.length - 1] - xs[0]),
      ys[0] + Math.min(1, Math.max(0, fy)) * (ys[ys.length - 1] - ys[0]),
    ];
  }

  canvas.addEventListener("click", (ev) => {
    keyboardActive = false;
    start(toData(ev));
  });
  canvas.addEventListener("pointermove", (ev) => {
    if (timer) return;
    keyboardActive = false;
    hover = toData(ev);
    readout(hover);
    draw();
  });
  canvas.addEventListener("pointerleave", () => {
    hover = null;
    if (!timer) draw();
  });
  canvas.addEventListener("keydown", (ev) => {
    const xs = data.log10_lam, ys = data.log10_gamma;
    const dx = (xs[xs.length - 1] - xs[0]) * (ev.shiftKey ? 0.1 : 0.02), dy = (ys[ys.length - 1] - ys[0]) * (ev.shiftKey ? 0.1 : 0.02);
    const move: Record<string, [number, number]> = { ArrowLeft: [-dx, 0], ArrowRight: [dx, 0], ArrowUp: [0, dy], ArrowDown: [0, -dy] };
    if (ev.key in move) {
      cursor[0] = Math.min(xs[xs.length - 1], Math.max(xs[0], cursor[0] + move[ev.key][0]));
      cursor[1] = Math.min(ys[ys.length - 1], Math.max(ys[0], cursor[1] + move[ev.key][1]));
      readout(cursor);
    } else if (ev.key === "Enter" || ev.key === " ") {
      start([...cursor]);
    } else {
      return;
    }
    ev.preventDefault();
    keyboardActive = true;
    draw();
  });
  canvas.addEventListener("focus", () => {
    keyboardActive = true;
    if (data) draw();
  });
  canvas.addEventListener("blur", () => {
    keyboardActive = false;
    if (data) draw();
  });
  root.querySelector("[data-starts]")!.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("[data-start]");
    if (!b) return;
    const [x, y] = b.getAttribute("data-start")!.split(",").map(Number);
    start([x, y]);
  });
  const legend = root.querySelector<HTMLElement>("[data-legend]")!;
  const syncLegend = () => {
    legend.querySelector<HTMLElement>("[data-leg=gd]")!.hidden = method === "lbfgs";
    legend.querySelector<HTMLElement>("[data-leg=lbfgs]")!.hidden = method === "gd";
  };
  syncLegend();
  const methodBtns = root.querySelectorAll<HTMLButtonElement>("[data-method]");
  methodBtns.forEach((b) =>
    b.addEventListener("click", () => {
      method = b.dataset.method as Method;
      methodBtns.forEach((o) => {
        o.setAttribute("aria-pressed", String(o === b));
        o.classList.toggle("active", o === b);
      });
      syncLegend();
    }),
  );
  const arrowsBtn = root.querySelector<HTMLButtonElement>("[data-arrows]")!;
  arrowsBtn.addEventListener("click", () => {
    showArrows = !showArrows;
    arrowsBtn.setAttribute("aria-pressed", String(showArrows));
    arrowsBtn.textContent = showArrows ? "Hide arrows" : "Show arrows";
    draw();
  });
  root.querySelector("[data-clear]")!.addEventListener("click", () => {
    clearInterval(timer);
    timer = 0;
    token++;
    runs = {};
    summary.textContent = "Hover over the map to read the exact gradient at a point.";
    draw();
  });
  onTheme(() => data && draw());
  observeWidth(canvas, (w) => {
    W = Math.max(300, w);
    H = Math.round(Math.min(520, Math.max(320, W * 0.9)));
    canvas.style.aspectRatio = `${W} / ${H}`;
    ctx = setupCanvas(canvas, W, H);
    if (data) draw();
  });
  fetch(root.dataset.src!)
    .then((r) => r.json())
    .then((d: Data) => {
      data = d;
      ({ E, G } = createHermite({ xs: d.log10_lam, ys: d.log10_gamma, f: d.cv_error, fx: d.grad_log10_lam, fy: d.grad_log10_gamma }));
      draw();
    });
</script>

<style>
  canvas {
    cursor: crosshair;
    touch-action: manipulation;
  }
  canvas:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .legend [hidden] {
    display: none;
  }
  .sw {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 0.2rem;
    vertical-align: -1px;
    border: 2px solid var(--surface);
    outline: 1.5px solid;
  }
  .sw.gd {
    border-radius: 50%;
    background: var(--accent-2);
    outline-color: var(--accent-2);
  }
  .sw.lb {
    background: var(--ok);
    outline-color: var(--ok);
  }
  .readout {
    margin: 1rem 0 0;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 0.92rem;
    color: var(--ink);
    min-height: 2.6em;
  }
</style>
