---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<div class="demo card" data-wasm={`${base}/wasm/smo_solver_wasm.wasm`}>
  <div class="demo-canvas">
    <canvas width="560" height="560" tabindex="0" role="application" aria-label="Training data and decision function" aria-describedby="demo-hint"></canvas>
    <p class="hint" id="demo-hint">Click to add a point of the selected class, right-click (or shift-click) for the other class. With the keyboard: arrow keys move the cursor (hold Shift for larger steps), Enter adds a point, Shift+Enter adds one of the other class, Backspace removes the last point. With the logistic loss, the probability at the pointer or cursor is shown in the panel.</p>
  </div>
  <div class="demo-panel">
    <div class="row">
      <span class="label">Data</span>
      <div class="chips" data-presets role="group" aria-label="Data set">
        <button class="chip active" data-preset="checkerboard" aria-pressed="true">Checkerboard</button>
        <button class="chip" data-preset="moons" aria-pressed="false">Moons</button>
        <button class="chip" data-preset="rings" aria-pressed="false">Rings</button>
        <button class="chip" data-preset="clear" aria-pressed="false">Empty</button>
      </div>
    </div>
    <div class="row">
      <span class="label">Loss</span>
      <div class="chips" data-losses role="group" aria-label="Loss function">
        <button class="chip active" data-loss="hinge" aria-pressed="true">Hinge (SVM)</button>
        <button class="chip" data-loss="logistic" aria-pressed="false">Logistic (probabilities)</button>
      </div>
    </div>
    <div class="row">
      <span class="label">Click adds</span>
      <div class="chips" data-classes role="group" aria-label="Class added on click">
        <button class="chip active" data-class="1" aria-pressed="true"><i class="dot pos"></i> class +1</button>
        <button class="chip" data-class="-1" aria-pressed="false"><i class="dot neg"></i> class −1</button>
      </div>
    </div>
    <label class="slider">
      <span>Regularization λ <output data-out="lam"></output></span>
      <input type="range" min="-5" max="0" step="0.1" value="-3" data-param="lam" />
    </label>
    <label class="slider">
      <span>Kernel width γ <output data-out="gamma"></output></span>
      <input type="range" min="-1" max="3" step="0.05" value="1.5" data-param="gamma" />
    </label>
    <label class="slider">
      <span>Loss smoothing δ <output data-out="smoothing"></output></span>
      <input type="range" min="0" max="1" step="0.05" value="0" data-param="smoothing" aria-describedby="demo-smooth-reason" />
    </label>
    <p class="slider-reason" id="demo-smooth-reason" data-smooth-reason hidden>Not used by the logistic loss: it is already smooth.</p>
    <div class="btn-row">
      <button class="btn small primary" type="button" data-tune>Tune λ and γ</button>
      <button class="btn small" type="button" data-stop hidden>Stop</button>
      <button class="btn small" type="button" data-watch>Watch SMO</button>
    </div>
    <p class="readout" data-readout hidden aria-hidden="true"></p>
    <p class="sr-only" role="status" aria-live="polite" data-readout-live></p>
    <p class="tune-status" role="status" data-status></p>
    <div class="tune-panel" data-tune-panel hidden><div class="tune-inset" data-inset></div></div>
    <div class="watch-panel" data-watch-panel hidden>
      <button class="btn small" type="button" data-play>Pause</button>
      <input type="range" min="0" max="0" step="1" value="0" data-scrub aria-label="SMO frame" data-scrub-label />
      <button class="btn small" type="button" data-watch-close>Close</button>
      <output data-watch-out></output>
    </div>
    <dl class="stats" aria-live="polite">
      <div><dt>samples</dt><dd data-stat="n">–</dd></div>
      <div><dt data-label="sv">support vectors</dt><dd data-stat="sv">–</dd></div>
      <div><dt data-label="steps">SMO steps</dt><dd data-stat="steps">–</dd></div>
      <div><dt>training time</dt><dd data-stat="time">–</dd></div>
      <div><dt>training accuracy</dt><dd data-stat="acc">–</dd></div>
      <div><dt data-label="gap">duality gap</dt><dd data-stat="gap">–</dd></div>
      <div data-logistic-only hidden><dt>training log loss</dt><dd data-stat="logloss">–</dd></div>
      <div><dt data-label="cv">5-fold CV loss</dt><dd data-stat="cv">–</dd></div>
      <div><dt>CV evaluations</dt><dd data-stat="evals">–</dd></div>
    </dl>
    <p class="note">
      Runs the Rust solver <code>smo-solver</code> compiled to WebAssembly (167 KB) directly in your
      browser. <span data-note-hinge>Ringed points are support vectors.</span>
      <span data-note-logistic hidden>The logistic loss is trained by Newton's method. The colour shows
      P(class +1) with contours at 0.1, 0.5 (bold, the decision boundary) and 0.9. There are no
      support-vector rings: every point contributes to the model.</span>
    </p>
    <p class="note">
      <strong>Tune λ and γ</strong> minimizes the 5-fold cross-validation loss (<span data-note-cvloss>smoothed hinge loss</span> on the held-out folds) with L-BFGS-B, using the
      exact gradient with respect to log λ and log γ, in a background thread.{" "}
      <span data-note-smooth>The gradient needs a smoothed loss, so a smoothing δ of 0 is raised to 0.2 for tuning.{" "}</span>
      <strong data-note-watch>Watch SMO</strong> replays the{" "}
      <span data-note-iter>solver iteration by iteration</span> for the current parameters.
    </p>
  </div>
</div>

<script>
  import { getSvmClient, SvmCancelledError, SvmSupersededError, type SvmTraceResult, type SvmTrainResult, type SvmTuneProgress } from "../lib/svm-client";
  import { createPacer, createTuneInset, reducedMotion, type TunePoint } from "../lib/tune-ui";

  const root = document.querySelector<HTMLElement>(".demo")!;
  const canvas = root.querySelector("canvas")!;
  const ctx = canvas.getContext("2d")!;
  const RES = 112; // decision function grid resolution
  const solver = getSvmClient(root.dataset.wasm!);
  let points: { x: number; y: number; c: number }[] = [];
  let clickClass = 1;
  let pending = 0;
  let keyboardActive = false;
  const LN10 = Math.LN10;
  const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const sliders = (k: string) => q<HTMLInputElement>(`[data-param=${k}]`);
  /** Exact (unrounded) parameters set by the tuner; cleared as soon as a slider is moved by hand. */
  let exact: { lam: number; gamma: number; smoothing: number } | null = null;
  let busy: "idle" | "tuning" = "idle";
  let watch: { trace: SvmTraceResult; snapshot: typeof points; frame: number; timer: number; playing: boolean; loss: Loss } | null = null;

  // deterministic random numbers so that presets look the same on every visit
  function rng(seed: number) {
    return () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    };
  }

  function preset(name: string) {
    const r = rng(7);
    const pts: typeof points = [];
    const gauss = () => Math.sqrt(-2 * Math.log(r() + 1e-12)) * Math.cos(2 * Math.PI * r());
    if (name === "checkerboard") {
      for (let i = 0; i < 300; i++) {
        const x = r(), y = r();
        const s = Math.sin(4 * Math.PI * x) * Math.sin(4 * Math.PI * y);
        pts.push({ x, y, c: (s > 0 ? 1 : -1) * (r() < 0.04 ? -1 : 1) });
      }
    } else if (name === "moons") {
      for (let i = 0; i < 240; i++) {
        const t = Math.PI * r(), up = i % 2 === 0;
        const x = up ? Math.cos(t) : 1 - Math.cos(t);
        const y = up ? Math.sin(t) : 0.5 - Math.sin(t);
        pts.push({ x: 0.2 + 0.3 * x + 0.03 * gauss(), y: 0.35 + 0.35 * y + 0.03 * gauss(), c: up ? 1 : -1 });
      }
    } else if (name === "rings") {
      for (let i = 0; i < 260; i++) {
        const inner = i % 2 === 0, t = 2 * Math.PI * r();
        const rad = (inner ? 0.15 : 0.36) + 0.035 * gauss();
        pts.push({ x: 0.5 + rad * Math.cos(t), y: 0.5 + rad * Math.sin(t), c: inner ? 1 : -1 });
      }
    }
    points = pts;
  }

  function params() {
    const v = (k: string) => Number(sliders(k).value);
    if (exact) return exact;
    return { lam: 10 ** v("lam"), gamma: 10 ** v("gamma"), smoothing: v("smoothing") };
  }

  function css(name: string) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  // any CSS colour (e.g. "#fff", minified by the build) -> [r, g, b]
  function hexToRgb(color: string): [number, number, number] {
    ctx.fillStyle = "#000";
    ctx.fillStyle = color;
    const h = String(ctx.fillStyle).replace("#", "");
    return [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16)) as [number, number, number];
  }

  function setStat(k: string, v: string) {
    root.querySelector(`[data-stat=${k}]`)!.textContent = v;
  }

  function fmt(x: number) {
    return x >= 0.01 && x < 1000 ? x.toPrecision(3) : x.toExponential(1);
  }

  type Loss = "hinge" | "logistic";
  let loss: Loss = "hinge";
  const sigmoid = (f: number) => 1 / (1 + Math.exp(-f));
  const LOGIT_90 = Math.log(9); // logit of p = 0.9 (and minus the logit of p = 0.1)
  let last: { dec: ArrayLike<number> | null; sv: Set<number>; loss: Loss } = { dec: null, sv: new Set(), loss };
  const cursor = { x: 0.5, y: 0.5 };
  const redraw = () => render(last.dec, last.sv, last.loss);

  /** Draws the picture. `dec` is the decision function (hinge) or the logit (logistic) on the grid. */
  function render(dec: ArrayLike<number> | null, sv: Set<number>, lo: Loss = loss) {
    last = { dec, sv, loss: lo };
    const W = canvas.width, H = canvas.height;
    const bg = hexToRgb(css("--surface") || "#ffffff");
    const pos = hexToRgb(css("--accent") || "#1d4ed8");
    const neg = hexToRgb(css("--accent-2") || "#c2410c");
    const img = ctx.createImageData(RES, RES);
    for (let j = 0; j < RES; j++) {
      for (let i = 0; i < RES; i++) {
        const d = dec ? dec[j * RES + i] : 0;
        // hinge: |f| up to 1.5; logistic: |2 P(+1) - 1| (0.5 is neutral)
        const w = (lo === "logistic" ? Math.abs(2 * sigmoid(d) - 1) : Math.min(Math.abs(d), 1.5) / 1.5) * 0.32;
        const c = d > 0 ? pos : neg;
        const o = 4 * ((RES - 1 - j) * RES + i);
        for (let k = 0; k < 3; k++) img.data[o + k] = Math.round(bg[k] * (1 - w) + c[k] * w);
        img.data[o + 3] = 255;
      }
    }
    const off = new OffscreenCanvas(RES, RES);
    off.getContext("2d")!.putImageData(img, 0, 0);
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, 0, 0, W, H);
    // contour lines: marching squares on the grid. hinge: f = 0; logistic: p = 0.1, 0.5 (bold), 0.9
    if (dec) {
      const sx = W / (RES - 1), sy = H / (RES - 1);
      const at = (i: number, j: number) => dec[j * RES + i];
      const contour = (level: number, width: number, alpha: number) => {
        ctx.strokeStyle = css("--ink");
        ctx.lineWidth = width;
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        for (let j = 0; j < RES - 1; j++) {
          for (let i = 0; i < RES - 1; i++) {
            const v = [at(i, j) - level, at(i + 1, j) - level, at(i + 1, j + 1) - level, at(i, j + 1) - level];
            const pts: [number, number][] = [];
            const edges: [number, number, number, number, number, number][] = [
              [0, 1, i, j, 1, 0], [1, 2, i + 1, j, 0, 1], [3, 2, i, j + 1, 1, 0], [0, 3, i, j, 0, 1],
            ];
            for (const [a, b, x0, y0, dx, dy] of edges) {
              if ((v[a] > 0) !== (v[b] > 0)) {
                const t = v[a] / (v[a] - v[b]);
                pts.push([(x0 + dx * t) * sx, H - (y0 + dy * t) * sy]);
              }
            }
            if (pts.length >= 2) {
              ctx.moveTo(...pts[0]);
              ctx.lineTo(...pts[1]);
              if (pts.length === 4) {
                ctx.moveTo(...pts[2]);
                ctx.lineTo(...pts[3]);
              }
            }
          }
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      };
      if (lo === "logistic") {
        contour(-LOGIT_90, 1, 0.55);
        contour(LOGIT_90, 1, 0.55);
      }
      contour(0, 2, 1);
    }
    points.forEach((p, k) => {
      const x = p.x * W, y = (1 - p.y) * H;
      ctx.fillStyle = p.c > 0 ? css("--accent") : css("--accent-2");
      ctx.beginPath();
      ctx.arc(x, y, 3.6, 0, 2 * Math.PI);
      ctx.fill();
      if (lo === "hinge" && sv.has(k)) {
        ctx.strokeStyle = css("--ink");
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, 2 * Math.PI);
        ctx.stroke();
      }
    });
    updateReadout();
    if (document.activeElement === canvas && keyboardActive) {
      const x = cursor.x * W, y = (1 - cursor.y) * H;
      ctx.strokeStyle = css("--ink");
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      ctx.arc(x, y, 11, 0, 2 * Math.PI);
      ctx.moveTo(x - 16, y);
      ctx.lineTo(x + 16, y);
      ctx.moveTo(x, y - 16);
      ctx.lineTo(x, y + 16);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  function gridPoints() {
    const m = RES * RES;
    const grid = new Float64Array(2 * m);
    for (let j = 0; j < RES; j++) {
      for (let i = 0; i < RES; i++) {
        grid[2 * (j * RES + i)] = i / (RES - 1);
        grid[2 * (j * RES + i) + 1] = j / (RES - 1);
      }
    }
    return grid;
  }

  async function train() {
    const n = points.length;
    setStat("n", String(n));
    const snapshot = points.slice();
    const classes = new Set(snapshot.map((p) => p.c));
    if (n < 2 || classes.size < 2) {
      for (const k of ["sv", "steps", "time", "acc", "gap", "logloss"]) setStat(k, "–");
      render(null, new Set());
      return;
    }
    if (last.dec && last.loss === loss) redraw(); // show the new points right away, the model follows
    const { lam, gamma, smoothing } = params();
    const grid = gridPoints();
    const lossNow = loss;
    let r;
    try {
      r = await solver.train({
        x: new Float64Array(snapshot.flatMap((p) => [p.x, p.y])),
        y: new Float64Array(snapshot.map((p) => p.c)),
        dim: 2, kind: kindOf(), lambda: lam, gamma, smoothing, epsilon: 0, tol: trainTol(), grid,
      });
    } catch (err) {
      if (!(err instanceof SvmSupersededError || err instanceof SvmCancelledError)) console.error(err);
      return;
    }
    if (lossNow !== loss) return; // the loss was switched meanwhile
    showResult(snapshot, r);
  }

  const kindOf = () => (loss === "logistic" ? "logistic" as const : "classification" as const);
  const trainTol = () => (loss === "logistic" ? 1e-8 : 1e-3);

  function showResult(snapshot: typeof points, r: SvmTrainResult) {
    const n = snapshot.length;
    if (r.steps < 0) {
      for (const k of ["sv", "steps", "time", "acc", "gap", "logloss"]) setStat(k, "–");
      render(null, new Set());
      return;
    }
    let correct = 0, logLoss = 0;
    snapshot.forEach((p, k) => {
      const m = r.decisionOnTrain[k] * p.c; // margin y f
      correct += m > 0 ? 1 : 0;
      logLoss += m > 0 ? Math.log1p(Math.exp(-m)) : -m + Math.log1p(Math.exp(m));
    });
    const nsv = r.support.length;
    setStat("sv", loss === "logistic" ? "–" : `${nsv} (${Math.round((100 * nsv) / n)} %)`);
    setStat("logloss", loss === "logistic" ? (logLoss / n).toFixed(4) : "–");
    setStat("steps", r.steps.toLocaleString("en"));
    setStat("time", `${(1000 * r.seconds).toFixed(1)} ms`);
    setStat("acc", `${((100 * correct) / n).toFixed(1)} %`);
    setStat("gap", fmt(Math.max(r.gap, 0)));
    render(r.decisionOnGrid, new Set(loss === "logistic" ? [] : Array.from(r.support, Number)));
  }

  // ---- probability read-out (logistic loss) ----
  const readoutEl = q("[data-readout]");
  const liveEl = q("[data-readout-live]");
  let probe: { x: number; y: number } | null = null;
  let liveTimer = 0, liveText = "", liveAt = -Infinity;
  /** Bilinear interpolation of the logit on the grid at (x, y) in [0, 1]^2, then the sigmoid. */
  function probabilityAt(dec: ArrayLike<number>, x: number, y: number) {
    const gx = Math.min(Math.max(x, 0), 1) * (RES - 1), gy = Math.min(Math.max(y, 0), 1) * (RES - 1);
    const i = Math.min(Math.floor(gx), RES - 2), j = Math.min(Math.floor(gy), RES - 2);
    const tx = gx - i, ty = gy - j;
    const f = (1 - ty) * ((1 - tx) * dec[j * RES + i] + tx * dec[j * RES + i + 1]) +
      ty * ((1 - tx) * dec[(j + 1) * RES + i] + tx * dec[(j + 1) * RES + i + 1]);
    return sigmoid(f);
  }
  function updateReadout() {
    readoutEl.hidden = loss !== "logistic";
    if (loss !== "logistic") return;
    if (last.loss !== "logistic" || !last.dec || !probe) {
      readoutEl.textContent = "Move the pointer over the picture to read P(class +1).";
      return;
    }
    const text = `P(class +1) = ${probabilityAt(last.dec, probe.x, probe.y).toFixed(2)}`;
    readoutEl.textContent = text;
    // screen readers: at most one announcement every 800 ms (trailing)
    liveText = text;
    if (!liveTimer) {
      liveTimer = window.setTimeout(() => {
        liveTimer = 0;
        liveAt = performance.now();
        if (liveEl.textContent !== liveText) liveEl.textContent = liveText;
      }, Math.max(0, liveAt + 800 - performance.now()));
    }
  }
  canvas.addEventListener("pointermove", (ev) => {
    if (loss !== "logistic") return;
    const r = canvas.getBoundingClientRect();
    probe = { x: (ev.clientX - r.left) / r.width, y: 1 - (ev.clientY - r.top) / r.height };
    updateReadout();
  });
  canvas.addEventListener("pointerleave", () => {
    probe = keyboardActive ? { ...cursor } : null;
    updateReadout();
  });

  function schedule() {
    const { lam, gamma, smoothing } = params();
    root.querySelector("[data-out=lam]")!.textContent = fmt(lam);
    root.querySelector("[data-out=gamma]")!.textContent = fmt(gamma);
    root.querySelector("[data-out=smoothing]")!.textContent = loss === "logistic" ? "n/a" : smoothing.toFixed(2);
    if (busy !== "idle") return; // the tuner owns the picture
    if (watch) return showFrame(watch.frame);
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(train);
  }

  function activate(group: Element, button: Element) {
    group.querySelectorAll(".chip").forEach((b) => {
      b.classList.toggle("active", b === button);
      b.setAttribute("aria-pressed", String(b === button));
    });
  }

  root.querySelectorAll("[data-param]").forEach((el) =>
    el.addEventListener("input", () => {
      exact = null;
      edited();
    }),
  );
  root.querySelector("[data-presets]")!.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("[data-preset]");
    if (!b) return;
    activate(b.parentElement!, b);
    preset(b.getAttribute("data-preset")!);
    edited();
  });
  const lossButtons = root.querySelectorAll<HTMLButtonElement>("[data-loss]");
  const smoothInput = sliders("smoothing");
  /** Adapts labels, notes and the smoothing slider to the selected loss. */
  function applyLoss() {
    const lg = loss === "logistic";
    const set = (sel: string, text: string) => (q(sel).textContent = text);
    set("[data-label=steps]", lg ? "Newton iterations" : "SMO steps");
    set("[data-label=gap]", lg ? "optimality" : "duality gap");
    set("[data-label=cv]", lg ? "5-fold CV log loss" : "5-fold CV loss");
    set("[data-watch]", lg ? "Watch Newton" : "Watch SMO");
    set("[data-note-watch]", lg ? "Watch Newton" : "Watch SMO");
    set("[data-note-iter]", lg ? "Newton iterations" : "solver iteration by iteration");
    set("[data-note-cvloss]", lg ? "log loss" : "smoothed hinge loss");
    q("[data-scrub-label]").setAttribute("aria-label", lg ? "Newton frame" : "SMO frame");
    q("[data-logistic-only]").hidden = !lg;
    q("[data-note-smooth]").hidden = lg;
    q("[data-note-hinge]").hidden = lg;
    q("[data-note-logistic]").hidden = !lg;
    q("[data-smooth-reason]").hidden = !lg;
    smoothInput.setAttribute("aria-disabled", String(lg));
    smoothInput.disabled = lg || busy !== "idle";
    smoothInput.closest("label")!.classList.toggle("disabled", lg);
    readoutEl.hidden = !lg;
    if (!lg) {
      liveEl.textContent = "";
      probe = null;
    }
  }
  lossButtons.forEach((b) =>
    b.addEventListener("click", () => {
      const next = b.dataset.loss as Loss;
      if (busy !== "idle" || next === loss) return;
      loss = next;
      activate(b.parentElement!, b);
      applyLoss();
      if (loss === "logistic" && keyboardActive) probe = { ...cursor };
      edited(); // closes a running replay, clears the CV numbers and retrains
    }),
  );
  root.querySelector("[data-classes]")!.addEventListener("click", (ev) => {
    const b = (ev.target as HTMLElement).closest("[data-class]");
    if (!b) return;
    activate(b.parentElement!, b);
    clickClass = Number(b.getAttribute("data-class"));
  });
  function addPoint(ev: MouseEvent, flip: boolean) {
    const r = canvas.getBoundingClientRect();
    const x = (ev.clientX - r.left) / r.width, y = 1 - (ev.clientY - r.top) / r.height;
    points.push({ x, y, c: flip ? -clickClass : clickClass });
    edited();
  }
  canvas.addEventListener("click", (ev) => {
    if (busy !== "idle") return;
    keyboardActive = false;
    addPoint(ev, ev.shiftKey);
  });
  canvas.addEventListener("keydown", (ev) => {
    if (busy !== "idle") return;
    const step = ev.shiftKey && !["Enter", " "].includes(ev.key) ? 0.1 : 0.02;
    const move: Record<string, [number, number]> = {
      ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, step], ArrowDown: [0, -step],
    };
    if (ev.key in move) {
      const [dx, dy] = move[ev.key];
      cursor.x = Math.min(1, Math.max(0, cursor.x + dx));
      cursor.y = Math.min(1, Math.max(0, cursor.y + dy));
    } else if (ev.key === "Enter" || ev.key === " ") {
      points.push({ x: cursor.x, y: cursor.y, c: ev.shiftKey ? -clickClass : clickClass });
      edited();
    } else if (ev.key === "Backspace" || ev.key === "Delete") {
      points.pop();
      edited();
    } else {
      return;
    }
    ev.preventDefault();
    keyboardActive = true;
    probe = { ...cursor };
    redraw();
  });
  canvas.addEventListener("focus", () => {
    keyboardActive = true;
    probe = { ...cursor };
    redraw();
  });
  canvas.addEventListener("blur", () => redraw());
  canvas.addEventListener("contextmenu", (ev) => {
    ev.preventDefault();
    if (busy === "idle") addPoint(ev, true);
  });
  window.addEventListener("themechange", schedule);
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", schedule);

  // ---- hyperparameter tuning and SMO replay ----
  const statusEl = q("[data-status]");
  const tuneBtn = q<HTMLButtonElement>("[data-tune]");
  const stopBtn = q<HTMLButtonElement>("[data-stop]");
  const watchBtn = q<HTMLButtonElement>("[data-watch]");
  const tunePanel = q("[data-tune-panel]");
  const watchPanel = q("[data-watch-panel]");
  const playBtn = q<HTMLButtonElement>("[data-play]");
  const scrub = q<HTMLInputElement>("[data-scrub]");
  const watchOut = q("[data-watch-out]");
  const range = (k: string): [number, number] => [Number(sliders(k).min), Number(sliders(k).max)];
  const inset = createTuneInset(q("[data-inset]"), { lam: range("lam"), gamma: range("gamma") });
  const status = (t: string) => (statusEl.textContent = t);
  let stopped = false;
  let watchToken = 0;

  /** Data or parameters were changed by the user: the replay and the CV numbers no longer apply. */
  function edited() {
    exitWatch();
    setStat("cv", "–");
    setStat("evals", "–");
    status("");
    schedule();
  }

  function setLocked(on: boolean) {
    root.querySelectorAll<HTMLInputElement | HTMLButtonElement>("[data-param], [data-preset], [data-loss]").forEach((el) => (el.disabled = on));
    smoothInput.disabled = on || loss === "logistic";
    tuneBtn.disabled = on;
    watchBtn.disabled = on;
    stopBtn.hidden = !on;
    canvas.setAttribute("aria-disabled", String(on));
  }

  /** Moves the sliders (rounded to their step) and the read-outs (exact values) to the parameters. */
  function showParams(lam: number, gamma: number, smoothing: number) {
    exact = { lam, gamma, smoothing };
    sliders("lam").value = String(Math.log10(lam));
    sliders("gamma").value = String(Math.log10(gamma));
    sliders("smoothing").value = String(smoothing);
    q("[data-out=lam]").textContent = fmt(lam);
    q("[data-out=gamma]").textContent = fmt(gamma);
    q("[data-out=smoothing]").textContent = loss === "logistic" ? "n/a" : smoothing.toFixed(2);
  }

  const classesOk = (snap: typeof points, min: number) =>
    snap.filter((p) => p.c > 0).length >= min && snap.filter((p) => p.c < 0).length >= min;

  async function tune() {
    if (busy !== "idle") return;
    const snap = points.slice();
    if (!classesOk(snap, 5)) return status("Tuning needs at least 5 points of each class (5-fold cross-validation).");
    if (solver.mode === "main") return status("Tuning needs Web Workers, which this browser does not provide.");
    exitWatch();
    let { lam, gamma, smoothing } = params();
    let note = "";
    if (loss === "hinge" && smoothing <= 0) {
      smoothing = 0.2;
      note = " Smoothing δ was 0 and is now 0.2: the hypergradient needs a smoothed loss.";
    }
    showParams(lam, gamma, smoothing);
    busy = "tuning";
    stopped = false;
    setLocked(true);
    stopBtn.focus();
    tunePanel.hidden = false;
    const hist: TunePoint[] = [];
    inset.set(hist);
    setStat("cv", "–");
    setStat("evals", "0");
    status("Tuning…" + note);
    const pacer = createPacer<SvmTuneProgress>((pr) => {
      showParams(Math.exp(pr.logLambda), Math.exp(pr.logGamma), smoothing);
      hist.push({ ll: pr.logLambda / LN10, lg: pr.logGamma / LN10, value: pr.value });
      inset.set(hist);
      setStat("cv", pr.value.toFixed(4));
      setStat("evals", String(pr.evaluation));
      render(pr.decisionOnGrid, new Set(loss === "logistic" ? [] : Array.from(pr.support, Number)));
    });
    try {
      const res = await solver.tune(
        {
          x: new Float64Array(snap.flatMap((p) => [p.x, p.y])),
          y: new Float64Array(snap.map((p) => p.c)),
          dim: 2, kind: kindOf(), folds: 5, smoothing, epsilon: 0, tol: loss === "logistic" ? 1e-8 : 1e-6, trainTol: trainTol(),
          initial: [Math.log(lam), Math.log(gamma)],
          lower: [range("lam")[0] * LN10, range("gamma")[0] * LN10],
          upper: [range("lam")[1] * LN10, range("gamma")[1] * LN10],
          maxIterations: 40, gradientTolerance: 1e-3, maxEvaluations: 60, grid: gridPoints(),
        },
        (pr) => pacer.push(pr),
      );
      await pacer.drain();
      if (stopped) throw new SvmCancelledError();
      showParams(Math.exp(res.logLambda), Math.exp(res.logGamma), smoothing);
      showResult(snap, res.final);
      setStat("cv", res.value.toFixed(4));
      setStat("evals", String(res.evaluations));
      const why = res.status === "converged" ? "converged"
        : res.status === "evaluation-limit" ? "stopped at the evaluation limit"
        : res.status === "solver-failure" ? "stopped: the solver did not converge at a trial point (best point kept)"
        : "finished without further progress";
      status(
        `Tuning ${why} after ${res.evaluations} evaluations${Number.isFinite(res.iterations) ? ` (${res.iterations} iterations)` : ""} ` +
          `in ${res.seconds.toFixed(1)} s: λ = ${fmt(Math.exp(res.logLambda))}, γ = ${fmt(Math.exp(res.logGamma))}, ` +
          `5-fold CV ${loss === "logistic" ? "log loss" : "loss"} ${res.value.toFixed(4)}.` + note,
      );
    } catch (err) {
      pacer.clear();
      if (err instanceof SvmCancelledError) {
        status(`Stopped after ${q("[data-stat=evals]").textContent} evaluations; the model shows the last parameters tried.`);
      } else {
        console.error(err);
        status(`Tuning failed: ${err instanceof Error ? err.message : err}`);
      }
      busy = "idle";
      schedule(); // retrain at the displayed parameters (the worker is recreated after a stop)
    } finally {
      const focusWasStop = document.activeElement === stopBtn;
      busy = "idle";
      setLocked(false);
      if (focusWasStop) tuneBtn.focus();
    }
  }

  stopBtn.addEventListener("click", () => {
    stopped = true;
    solver.cancel();
  });
  tuneBtn.addEventListener("click", tune);

  // SMO replay
  function showFrame(i: number) {
    if (!watch) return;
    const { trace, snapshot } = watch;
    const m = RES * RES, n = snapshot.length;
    watch.frame = i;
    const sv = new Set<number>();
    if (watch.loss === "hinge") for (let k = 0; k < n; k++) if (Math.abs(trace.coef[i * n + k]) > 1e-12) sv.add(k);
    render(trace.decision.subarray(i * m, (i + 1) * m), sv, watch.loss);
    scrub.value = String(i);
    const gap = trace.frameGap[i];
    const text = watch.loss === "logistic"
      ? `frame ${i + 1} of ${trace.frames} · Newton iteration ${trace.frameStep[i]} · optimality ${Number.isFinite(gap) ? fmt(gap) : "–"}`
      : `frame ${i + 1} of ${trace.frames} · SMO step ${trace.frameStep[i].toLocaleString("en")} · duality gap ${Number.isFinite(gap) ? fmt(gap) : "–"}`;
    watchOut.textContent = text;
    scrub.setAttribute("aria-valuetext", text);
  }

  function setPlaying(on: boolean) {
    if (!watch) return;
    clearTimeout(watch.timer);
    watch.playing = on;
    playBtn.textContent = on ? "Pause" : watch.frame >= watch.trace.frames - 1 ? "Replay" : "Play";
    if (!on) return;
    const w = watch;
    const tick = () => {
      if (watch !== w) return;
      if (w.frame >= w.trace.frames - 1) return setPlaying(false);
      showFrame(w.frame + 1);
      w.timer = window.setTimeout(tick, delay);
    };
    const delay = w.loss === "logistic" ? 600 : 100; // only a handful of Newton frames: slow down
    w.timer = window.setTimeout(tick, delay);
  }

  function exitWatch() {
    watchToken++;
    if (watch) clearTimeout(watch.timer);
    watch = null;
    watchPanel.hidden = true;
  }

  async function startWatch() {
    if (busy !== "idle") return;
    const snapshot = points.slice();
    if (snapshot.length < 2 || !classesOk(snapshot, 1)) return status("Add points of both classes first.");
    exitWatch();
    const token = watchToken;
    const { lam, gamma, smoothing } = params();
    const lossNow = loss;
    status(loss === "logistic" ? "Recording the Newton run…" : "Recording the SMO run…");
    let trace;
    try {
      trace = await solver.trace({
        x: new Float64Array(snapshot.flatMap((p) => [p.x, p.y])),
        y: new Float64Array(snapshot.map((p) => p.c)),
        dim: 2, kind: kindOf(), lambda: lam, gamma, smoothing, epsilon: 0, tol: trainTol(),
        grid: gridPoints(), maxFrames: 60,
      });
    } catch (err) {
      if (!(err instanceof SvmSupersededError || err instanceof SvmCancelledError)) {
        console.error(err);
        status(`Could not record the run: ${err instanceof Error ? err.message : err}`);
      }
      return;
    }
    if (token !== watchToken || lossNow !== loss) return; // the data or the loss changed meanwhile
    watch = { trace, snapshot, frame: 0, timer: 0, playing: false, loss: lossNow };
    const unit = lossNow === "logistic" ? "Newton iterations" : "SMO steps";
    scrub.max = String(trace.frames - 1);
    watchPanel.hidden = false;
    showFrame(0);
    if (reducedMotion()) {
      setPlaying(false);
      status(`${trace.steps.toLocaleString("en")} ${unit} in ${trace.frames} frames. Use the slider to step through them.`);
    } else {
      setPlaying(true);
      status(`Replaying ${trace.steps.toLocaleString("en")} ${unit} in ${trace.frames} frames.`);
    }
    scrub.focus();
  }

  watchBtn.addEventListener("click", startWatch);
  playBtn.addEventListener("click", () => {
    if (!watch) return;
    if (!watch.playing && watch.frame >= watch.trace.frames - 1) showFrame(0);
    setPlaying(!watch.playing);
  });
  scrub.addEventListener("input", () => {
    if (!watch) return;
    setPlaying(false);
    showFrame(Number(scrub.value));
    setPlaying(false);
  });
  q("[data-watch-close]").addEventListener("click", () => {
    exitWatch();
    status("");
    schedule();
    watchBtn.focus();
  });

  preset("checkerboard");
  applyLoss();
  schedule();
</script>

