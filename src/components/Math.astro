---
// Renders TeX at build time with KaTeX (no client-side JavaScript).
import katex from "katex";
interface Props {
  tex: string;
  block?: boolean;
}
const { tex, block = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: block, throwOnError: true, output: "html" });
---
{block ? <div class="math-block" set:html={html} /> : <span set:html={html} />}
