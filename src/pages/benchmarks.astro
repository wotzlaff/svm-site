python benchmarks/hpo_timing.py &gt; timing.json          # once per release, once per BLAS setting
python benchmarks/smo_newton_switch.py --out switch.csv
python benchmarks/primal_first_order.py run --aux --methods ""   # then --methods gd / pgd / pgd_w1 (about 20 min each)
python benchmarks/newton_vs_smo.py run --reps 3 > benchmarks/results/newton_vs_smo.csv

# this site (raw files in data/benchmarks/; the large smo-solver results are thinned first)
python scripts/make_benchmark_data.py --thin ../smo-solver/benchmarks/results ../optimized-svm/benchmarks/results
python scripts/make_benchmark_data.py</code></pre>
    </div>
  </section>

